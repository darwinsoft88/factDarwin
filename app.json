{
  "expo": {
    "name": "FactuDarwin",
    "slug": "factura-sri-mobile",
    "version": "1.0.13",
    "icon": "./assets/icon.png",
    "scheme": "factudarwin",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f7fb",
    "assetBundlePatterns": [
      "assets/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b6f68"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.facturasri.mobile",
      "buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "FactuDarwin usa la camara para escanear codigos de productos.",
        "NSLocalNetworkUsageDescription": "FactuDarwin puede conectarse a un servidor local solo en pruebas tecnicas autorizadas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.facturasri.mobile",
      "versionCode": 14,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b6f68"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "FactuDarwin usa la camara para escanear productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FactuDarwin usa sus fotos solo para asignar una imagen al producto.",
          "cameraPermission": "FactuDarwin usa la camara para tomar la foto del producto.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que FactuDarwin use Face ID para proteger el acceso a su cuenta."
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "web": {
      "favicon": "./assets/icon.png",
      "description": "FactuDarwin app de facturacion electronica para iOS y web."
    },
    "extra": {
      "eas": {
        "projectId": "8a8ee08e-e0c1-4d89-9406-62eb8b370ab9"
      }
    }
  }
}
