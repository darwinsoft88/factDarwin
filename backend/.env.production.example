NODE_ENV=production
PORT=4000
PUBLIC_BACKEND_URL=https://api.tu-dominio.com
CORS_ORIGINS=https://app.tu-dominio.com
REQUIRE_HTTPS=true

DATABASE_URL=postgres://usuario:clave@host:5432/factura_sri
PGSSLMODE=require

AUTH_REQUIRED=true
JWT_SECRET=CAMBIA_POR_UN_SECRETO_DE_32_CARACTERES_O_MAS
ASSET_ENCRYPTION_SECRET=CAMBIA_POR_OTRO_SECRETO_ESTABLE_DE_32_CARACTERES_O_MAS
JWT_EXPIRES_HOURS=12
MASTER_ADMIN_KEY=CAMBIA_POR_UNA_CLAVE_MAESTRA_DE_32_CARACTERES_O_MAS

SRI_ENV=production
SRI_ALLOW_SEND=true
SRI_ALLOW_INSECURE_TLS=false

UPLOADS_DIR=./uploads
PG_BACKUP_ENABLED=true
PG_BACKUP_DIR=./backups/postgres
PG_BACKUP_TIME=23:30
PG_BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump

SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tu-dominio.com
SMTP_PASS=CAMBIA_POR_PASSWORD_SMTP
SMTP_FROM=notificaciones@tu-dominio.com
DATOS_API_URL=https://webservices.ec
DATOS_API_TOKEN=CAMBIA_POR_TOKEN_DE_WEBSERVICES_EC

TECHNICAL_LOGS_ENABLED=true
TECHNICAL_LOGS_RETENTION_DAYS=30
TECHNICAL_LOGS_SUCCESS=false
TECHNICAL_LOGS_INCLUDE_STACK=false
