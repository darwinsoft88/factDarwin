NODE_ENV=production
PORT=4000
PUBLIC_BACKEND_URL=https://api.factudarwin.com
CORS_ORIGINS=https://app.factudarwin.com,https://factudarwin-app.pages.dev
REQUIRE_HTTPS=true

DATABASE_URL=postgres://usuario:clave@host:5432/factudarwin
PGSSLMODE=require

AUTH_REQUIRED=true
JWT_SECRET=GENERA_CON_NPM_RUN_SECRETS_GENERATE
ASSET_ENCRYPTION_SECRET=GENERA_CON_NPM_RUN_SECRETS_GENERATE
DEVICE_SESSION_TOKEN_PEPPER=GENERA_UN_SECRETO_INDEPENDIENTE_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_HOURS=12
# Activar solo despues de desplegar la migracion 006 y validar la PWA HTTPS.
PASSKEY_ENABLED=false
PASSKEY_RP_NAME=FactuDarwin
PASSKEY_RP_ID=app.factudarwin.com
PASSKEY_ORIGINS=https://app.factudarwin.com
MASTER_ADMIN_KEY=GENERA_CON_NPM_RUN_SECRETS_GENERATE
SUPPORT_ADMIN_ENABLED=true
SUPPORT_ADMIN_EMAIL=soporte@factudarwin.com
SUPPORT_ADMIN_NAME=Soporte DarwinSoft
SUPPORT_ADMIN_PASSWORD_HASH=GENERA_CON_NPM_RUN_SUPPORT_HASH

SRI_ENV=production
SRI_ALLOW_SEND=true
SRI_ALLOW_INSECURE_TLS=false

UPLOADS_DIR=./uploads
PG_BACKUP_ENABLED=true
PG_BACKUP_DIR=./backups/postgres
PG_BACKUP_TIME=23:30
PG_BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql

SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=60000
# off | simulate | send. Produccion debe permanecer off hasta habilitar un canary.
AUTOMATIC_AUTHORIZATION_EMAIL_MODE=off
SMTP_USER=notificaciones@tu-dominio.com
SMTP_PASS=CAMBIA_POR_PASSWORD_SMTP
SMTP_FROM=notificaciones@tu-dominio.com
DATOS_API_URL=https://webservices.ec
DATOS_API_TOKEN=CAMBIA_POR_TOKEN_DE_WEBSERVICES_EC

TECHNICAL_LOGS_ENABLED=true
TECHNICAL_LOGS_RETENTION_DAYS=30
TECHNICAL_LOGS_SUCCESS=false
TECHNICAL_LOGS_INCLUDE_STACK=false
