PORT=4000
SRI_ENV=test
SRI_CERT_PATH=./certs/firma.p12
SRI_CERT_PASSWORD=CAMBIA_ESTA_CLAVE
SRI_ALLOW_SEND=false
AUTH_REQUIRED=true
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO
ASSET_ENCRYPTION_SECRET=CAMBIA_ESTE_SECRETO_ESTABLE_PARA_FIRMAS
JWT_EXPIRES_HOURS=12
MASTER_ADMIN_KEY=CAMBIA_ESTA_CLAVE_MAESTRA_LARGA
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DATOS_API_URL=https://webservices.ec
DATOS_API_TOKEN=
DB_PATH=./data/factura-sri-main.db
# Para produccion use PostgreSQL. Si DATABASE_URL esta definido, se ignora DB_PATH.
DATABASE_URL=
PGSSLMODE=
PG_BACKUP_ENABLED=true
PG_BACKUP_DIR=./backups/postgres
PG_BACKUP_TIME=23:30
PG_BACKUP_RETENTION_DAYS=30
# Windows ejemplo: C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
TECHNICAL_LOGS_ENABLED=true
TECHNICAL_LOGS_DIR=./logs
TECHNICAL_LOGS_RETENTION_DAYS=30
TECHNICAL_LOGS_MAX_READ=300
TECHNICAL_LOGS_SUCCESS=false
TECHNICAL_LOGS_INCLUDE_STACK=false
