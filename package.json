{
  "name": "factura-sri-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "npx expo export --platform web && node scripts/prepare-pwa.js",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint App.tsx src scripts --ext .js,.jsx,.ts,.tsx",
    "test": "npx jest --runInBand",
    "check:backend": "node scripts/check-backend.js",
    "check:production": "node scripts/check-production.js",
    "release:preflight": "node scripts/production-preflight.js",
    "release:status": "node scripts/release-status.js",
    "smoke:production": "node scripts/smoke-production.js",
    "version:bump": "node scripts/bump-version.js",
    "release:android:check": "npm run release:preflight",
    "prebuild:android:aab": "npm run release:android:check",
    "presubmit:android": "npm run release:android:check",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:android:apk": "npx eas-cli build --platform android --profile preview",
    "build:android:aab": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-crypto": "~55.0.17",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "55.0.8",
    "expo-intent-launcher": "~55.0.14",
    "expo-linear-gradient": "~55.0.16",
    "expo-network": "~55.0.16",
    "expo-print": "~55.0.17",
    "expo-sharing": "~55.0.22",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.4",
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "5.9.3"
  }
}
