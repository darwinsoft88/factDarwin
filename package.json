{
  "name": "factura-sri-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint \"**/*.{js,jsx,ts,tsx}\"",
    "test": "npx jest --runInBand",
    "check:production": "node scripts/check-production.js",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:aab": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.26",
    "expo-camera": "~55.0.19",
    "expo-crypto": "~55.0.15",
    "expo-file-system": "~55.0.22",
    "expo-intent-launcher": "~55.0.12",
    "expo-network": "~55.0.14",
    "expo-print": "~55.0.15",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "19.2.15",
    "@types/jest": "^29.5.4",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eas-cli": "^18.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "5.9.3"
  }
}
